{
  "name": "ringwatch",
  "version": "2.1.0",
  "description": "Standalone Node.js 24/7 NVR & AI Package Detection backend with modern React web frontend for Ring cameras and alarm sensors.",
  "main": "dist-server/server/index.js",
  "author": "RingWatch",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "npm run build:server && node dist-server/server/index.js",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist-server/server/index.js",
    "start:server": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ring-client-api": "^14.3.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "minimatch": "^11.0.9",
    "werift": "^0.26.0"
  }
}
